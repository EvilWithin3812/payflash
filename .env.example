# Copy to .env (git-ignored) and fill in. Used by docker compose automatically.
#
# Local development needs NONE of these: docker-compose.yml has safe local defaults.
# Production (docker-compose.prod.yml) requires the ones marked REQUIRED.

# REQUIRED in production. Generate with:  openssl rand -base64 48
JWT_SECRET=
# REQUIRED in production: database passwords (any long random strings)
POSTGRES_PASSWORD=
NOTIFICATIONS_DB_PASSWORD=
# REQUIRED in production: first admin account (can create flash sales)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# REQUIRED in production: the public URL of the site, e.g. https://payflash.example.com
PUBLIC_ORIGIN=
# REQUIRED in production: Redis password (any long random string)
REDIS_PASSWORD=
# REQUIRED in production: Grafana admin password
GRAFANA_ADMIN_PASSWORD=
# REQUIRED in production: SMTP provider (e.g. Amazon SES: email-smtp.ap-south-1.amazonaws.com)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# REQUIRED in production: sender address for all emails (must be verified with your SMTP provider)
MAIL_FROM=PayFlash <no-reply@your-domain.com>
# Optional: how many days of daily database backups to keep (default 14 in production)
BACKUP_KEEP_DAYS=14

# Optional: Razorpay test-mode keys (https://dashboard.razorpay.com/app/keys, Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
